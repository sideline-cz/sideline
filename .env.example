DATABASE_URL=postgresql://sideline:sideline@localhost:5432/sideline

# Kill switch for the read-only in-app AI assistant. Accepted values (case-insensitive):
# true/1/yes/on to enable, false/0/no/off/empty to disable. Defaults to disabled — see
# `docs/deployment.md` §3.1 and `applications/server/src/env.ts`.
# AI_CHAT_ENABLED=true

# Discord `/report` → GitHub issue. Absent token = the command replies "not set up"
# and the bot still boots. Needs a fine-grained PAT with Issues: read & write on
# the target repo. See `applications/bot/src/services/githubIssue.ts`.
# GITHUB_REPORT_TOKEN=github_pat_...
# GITHUB_REPORT_REPO=sideline-cz/sideline
