{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "codegen": "pnpm --recursive --parallel run codegen && biome check --write packages/*/src/index.ts applications/*/src/index.ts",
    "dev": "pnpm --parallel dev",
    "build": "pnpm build:packages && pnpm build:applications",
    "build:applications": "pnpm --parallel --filter './applications/**' build",
    "build:packages": "pnpm --filter './packages/**' build",
    "check": "tsc -b tsconfig.json",
    "check:e2e": "tsc -p e2e/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write --unsafe .",
    "test": "vitest",
    "test:unit": "vitest",
    "test:integration": "pnpm --filter @sideline/server test:integration",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "coverage": "vitest --coverage",
    "db:up": "docker compose -f docker-compose.db.yaml up -d postgres",
    "db:down": "docker compose -f docker-compose.db.yaml down",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@babel/cli": "8.0.4",
    "@babel/core": "8.0.1",
    "@babel/plugin-transform-export-namespace-from": "8.0.1",
    "@babel/plugin-transform-modules-commonjs": "8.0.1",
    "@biomejs/biome": "2.5.10",
    "@effect/build-utils": "0.8.9",
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.0.0-rc.111",
    "@playwright/test": "^1.62",
    "@sideline/rules": "workspace:^",
    "@types/node": "26.1.1",
    "@vitest/ui": "4.1.11",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "effect": "4.0.0-beta.40",
    "glob": "^13.0.6",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "tsc-alias": "^1.9.2",
    "tsc-watch": "^7.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
